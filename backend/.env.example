SOCFORGE_DATABASE_URL=sqlite:///./socforge.db
SOCFORGE_JWT_SECRET=replace-this-with-a-random-secret
SOCFORGE_ENVIRONMENT=development
SOCFORGE_JWT_EXPIRE_MINUTES=30
SOCFORGE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SOCFORGE_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
SOCFORGE_DEFAULT_SHIFT_DURATION_MINUTES=30
SOCFORGE_DEFAULT_NOISE_EVENTS_PER_MINUTE=12
SOCFORGE_CRITICAL_ALERT_SLA_SECONDS=600
SOCFORGE_MAX_QUERY_ROWS=100000
